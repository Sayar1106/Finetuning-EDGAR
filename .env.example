# SEC EDGAR requires a descriptive identity (name + email) on every request; edgartools reads
# this env var directly. https://www.sec.gov/os/accessing-edgar-data
EDGAR_IDENTITY="Sayar Banerjee sayarbanerjee@gmail.com"

# Teacher LLM (Claude Haiku 4.5) used to label qualitative fields -- risk-factor categories and
# summaries -- in src/labels/. Numeric fields come from XBRL and need no teacher.
ANTHROPIC_API_KEY=

# Experiment tracking during fine-tuning (src/train/)
WANDB_API_KEY=
WANDB_PROJECT=finetuning-edgar

# Push/pull model artifacts and datasets to the Hub
HF_TOKEN=
